# =============================================================================
# SmartBus Command Dashboard — Consolidated .gitignore
# =============================================================================

# ── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.cert

# ── Node / Frontend Dependencies & Build ────────────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.npm/
.eslintcache
*.local

# ── Python & Virtual Environments ───────────────────────────────────────────
venv/
.venv/
env/
**/venv/
**/.venv/
**/env/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.egg
*.egg-info/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# ── Testing & Linting Caches ────────────────────────────────────────────────
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
htmlcov/

# ── IDEs & System Junk ──────────────────────────────────────────────────────
.vscode/
**/.vscode/
!.vscode/extensions.json
.idea/
**/.idea/
*.swp
*.swo
*~
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
.agents/
.gemini/

# ── Database & Log Files ────────────────────────────────────────────────────
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.sqlite
*.sqlite3
*.db

# ── Machine Learning Weights & Large Models ─────────────────────────────────
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.weights
*.bin
runs/
**/runs/

# ── Media & Runtime Generated Evidence ──────────────────────────────────────
backend/static/evidence/
**/static/evidence/
*.mp4
*.avi
*.mkv
*.mov

# ── ANPR Runtime Output (keep .gitkeep but ignore generated files) ────────────
anpr-detection/evidence_incidents/*
!anpr-detection/evidence_incidents/.gitkeep
anpr-detection/plate_crops/*
!anpr-detection/plate_crops/.gitkeep

# ── Test Artifacts ──────────────────────────────────────────────────────────
backend/test_event.json